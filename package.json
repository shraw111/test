{
  "name": "ui-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cdn": "node scripts/build-cdn.mjs",
    "build:types": "node scripts/build-types.mjs",
    "dev": "npm run build:cdn && npm run build:types && vite",
    "build": "npm run build:cdn && npm run build:types && tsc --noEmit && vite build",
    "serve:preview": "node scripts/serve-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:types && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@typescript/vfs": "1.6.5",
    "esbuild-wasm": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
