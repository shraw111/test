{
  "name": "ui-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cdn": "node scripts/build-cdn.mjs",
    "dev": "npm run build:cdn && vite",
    "build": "npm run build:cdn && tsc --noEmit && vite build",
    "serve:preview": "node scripts/serve-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "esbuild-wasm": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
